<Window x:Class="AlchemyCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alchemy Calculator" Height="900" Width="1400"
        MinHeight="820" MinWidth="1100"
        Background="#1E1E1E" Foreground="#E0E0E0"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="20,10"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="#8FC7E8" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="—" Click="MinimizeWindow_Click" Margin="12,0,0,0" Padding="10,4" ToolTip="Minimize"/>
                    <Button Content="×" Click="CloseWindow_Click" Margin="4,0,0,0" Padding="10,4" ToolTip="Close"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/kabancalculator.ico" Width="34" Height="34" Stretch="Uniform" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="CRAFTING CALCULATOR" FontSize="20" FontWeight="SemiBold" Foreground="#F0F0F0"/>
                        <TextBlock Text="Alchemy and Cooking app for Black Desert Online" Foreground="#8D929A" Margin="0,3,0,0"/>
                        <TextBlock Text="by Kanadoots" Foreground="#8D929A" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Margin="18" Background="#1E1E1E" BorderBrush="#3C3C3C">
            <TabItem Header="Calculator">
                <Grid Margin="2,18,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                        <DockPanel VerticalAlignment="Center">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Item Highlighter:" VerticalAlignment="Center" Foreground="#AEB2B8" Margin="0,0,10,0"/>
                                <Button x:Name="OutputHighlightButton" Content="Output: On" Click="OutputHighlightButton_Click" Width="113" Height="35" Margin="0,0,8,0"/>
                                <Button x:Name="InputHighlightButton" Content="Input: On" Click="InputHighlightButton_Click" Width="99" Height="35"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Target item" VerticalAlignment="Center" Foreground="#AEB2B8" Margin="0,0,8,0" Height="17"/>
                                <ComboBox x:Name="TargetCombo" Width="260" IsEditable="True" IsTextSearchEnabled="True"
                                          SelectionChanged="TargetCombo_SelectionChanged" Margin="0,0,22,0"
                                          ToolTip="Type to search recipes and ingredients" KeyDown="CalculateField_KeyDown"/>
                                <TextBlock Text="Quantity" VerticalAlignment="Center" Foreground="#AEB2B8" Margin="0,0,8,0" Height="17"/>
                                <TextBox x:Name="QuantityBox" Width="80" Text="1" Margin="0,0,12,0" KeyDown="CalculateField_KeyDown"/>
                                <Button Content="Calculate" Click="Calculate_Click" Background="#007ACC" BorderBrush="#007ACC" Height="35"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Tiered Breakdown Output" Grid.Column="0" Margin="0,0,10,0">
                            <DataGrid x:Name="BreakdownGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionChanged="BreakdownGrid_SelectionChanged" LoadingRow="BreakdownGrid_LoadingRow"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tier Structure" Binding="{Binding TierLabel}" Width="1.3*"/>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding DisplayName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Quantity Needed" Binding="{Binding QuantityLabel}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.25*"/>
                                <RowDefinition Height="0.75*"/>
                            </Grid.RowDefinitions>
                            <GroupBox Header="Recipe Details" Grid.Row="0" Margin="0,0,0,8" MinHeight="390" ClipToBounds="True">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Item name" Foreground="#8D929A" FontSize="11"/>
                                    <TextBlock x:Name="DetailItemName" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,10"/>
                                    <TextBlock Text="Tier" Foreground="#8D929A" FontSize="11"/>
                                    <TextBlock x:Name="DetailTier" Margin="0,2,0,10"/>
                                    <TextBlock x:Name="DetailRecipeHeading" Text="Recipe ingredients" FontWeight="SemiBold" Margin="0,2,0,5"/>
                                    <Grid x:Name="RecipeIngredientsGrid">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ingredient" Foreground="#8D929A" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="Per craft" Foreground="#8D929A" FontSize="11"
                                                       HorizontalAlignment="Stretch" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="Scaled" Foreground="#8D929A" FontSize="11"
                                                       HorizontalAlignment="Stretch" TextAlignment="Right"/>
                                    </Grid>
                                    <TextBlock x:Name="DetailBaseMaterial" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="DetailTotalOutput" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Ingredient usage" Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True">
                                <TextBox x:Name="UsageDetails" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Background="#2D2D2D" BorderThickness="0"
                                         FontFamily="Consolas"/>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Recipe Library">
                <Grid Margin="2,18,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Refresh" Click="RefreshLibrary_Click" Height="35"/>
                            <Button Content="Import Recipe Library" Click="ImportRecipes_Click" Height="35"/>
                            <Button Content="Export Recipe Library" Click="ExportRecipes_Click" Height="35"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ New Recipe" Click="NewRecipe_Click" Height="35"/>
                            <Button Content="Edit Recipe" Click="EditRecipe_Click" Height="35"/>
                            <Button Content="Delete" Click="DeleteRecipe_Click" Height="35"/>
                        </StackPanel>
                    </DockPanel>
                    <GroupBox Header="Recipes" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBox x:Name="RecipeSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                                     TextChanged="RecipeSearchBox_TextChanged" ToolTip="Search recipes"/>
                            <ListBox x:Name="RecipeList" DisplayMemberPath="Name" SelectionChanged="RecipeList_SelectionChanged"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="Recipe Editor" Grid.Row="1" Grid.Column="1">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="0.85*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="RecipeEditorPanel" Grid.Column="0" Margin="0,0,14,0" IsEnabled="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Recipe name" Foreground="#AEB2B8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="RecipeNameBox" Width="260" HorizontalAlignment="Left"
                                                 ToolTip="Recipe names must be unique"/>
                                    <TextBlock Text="Tier" Foreground="#AEB2B8" Margin="0,10,0,5"/>
                                    <ComboBox x:Name="RecipeTierCombo" Width="100" HorizontalAlignment="Left"
                                                  ToolTip="Choose the recipe tier (2 through 7)"/>
                                </StackPanel>
                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Ingredients (maximum 5)" FontWeight="SemiBold"/>
                                        <TextBlock Text="Choose from the existing recipe and raw ingredient library." Foreground="#7F858C" FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="MissingIngredientWarning" Text="⚠ Missing ingredient/recipe"
                                                   Foreground="IndianRed" Visibility="Collapsed" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <DataGrid x:Name="IngredientGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                                          LoadingRow="IngredientGrid_LoadingRow"
                                          CellEditEnding="IngredientGrid_CellEditEnding">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Ingredient / recipe" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="6,0"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.IngredientOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               IsEditable="False"
                                                              IsTextSearchEnabled="True"
                                                              StaysOpenOnEdit="True"
                                                               SelectedItem="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                               ToolTip="Search the existing recipe and ingredient library"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                    <Button Content="Save Recipe" Click="SaveRecipe_Click" Background="#007ACC" BorderBrush="#007ACC" Height="35" Margin="0"/>
                                </StackPanel>
                            </Grid>
                            <GroupBox x:Name="RecipeNotesPanel" Grid.Column="1" Header="Recipe Notes" IsEnabled="False">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Private notes for this recipe are saved with the library." TextWrapping="Wrap" Foreground="#7F858C" FontSize="11" Margin="0,0,0,10"/>
                                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             TextChanged="NotesBox_TextChanged" Background="#2D2D2D" BorderThickness="0"
                                             ToolTip="Add notes for this recipe"/>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Raw Ingredients">
                <Grid Margin="2,18,2,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Refresh" Click="RefreshLibrary_Click" Height="35"/>
                            <Button Content="Import Raw Ingredients" Click="ImportRaw_Click" Height="35"/>
                            <Button Content="Export Raw Ingredients" Click="ExportRaw_Click" Height="35"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ New Ingredient" Click="NewRaw_Click" Height="35"/>
                            <Button Content="Delete" Click="DeleteRaw_Click" Height="35"/>
                        </StackPanel>
                    </DockPanel>
                    <GroupBox Header="Raw Ingredient Library" Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBox x:Name="RawSearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                                     TextChanged="RawSearchBox_TextChanged" ToolTip="Search raw ingredients"/>
                            <ListBox x:Name="RawList" DisplayMemberPath="Name" SelectionChanged="RawList_SelectionChanged"/>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Header="Raw Ingredient Editor" Grid.Row="1" Grid.Column="1">
                        <StackPanel Margin="16">
                            <TextBlock Text="Raw ingredients are the base materials with no sub-recipe." Foreground="#92979E" Margin="0,0,0,18"/>
                            <TextBlock Text="Name" Foreground="#AEB2B8" Margin="0,0,0,5"/>
                            <TextBox x:Name="RawNameBox" Width="340" HorizontalAlignment="Left"/>
                            <TextBlock Text="Tier" Foreground="#AEB2B8" Margin="0,16,0,5"/>
                            <TextBlock Text="Tier 1 (fixed)" Foreground="#D8D8D8"/>
                            <GroupBox Header="Ingredient Notes" Margin="0,20,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Notes are saved with this raw ingredient."
                                               TextWrapping="Wrap" Foreground="#7F858C" FontSize="11" Margin="0,0,0,10"/>
                                    <TextBox x:Name="RawNotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" MinHeight="130"
                                             TextChanged="RawNotesBox_TextChanged"
                                             Background="#2D2D2D" BorderThickness="0"
                                             ToolTip="Add notes for this raw ingredient"/>
                                </DockPanel>
                            </GroupBox>
                            <Button Content="Save Ingredient" Click="SaveRaw_Click" Background="#007ACC" BorderBrush="#007ACC"
                                    HorizontalAlignment="Left" Height="35" Margin="0,20,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>